{
  "manifest_version": 3,
  "name": "SlotBuddy Quick Add",
  "version": "1.3.2",
  "description": "Rainbet Quick Add for SlotBuddy Bonus Hunt and Cozies, with customizable settings and a master on/off switch.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://rainbet.com/*",
    "https://www.rainbet.com/*",
    "https://jessicaedgar1997.github.io/stream-leaderboard/*",
    "https://xbogfbyysrjttyfvzluh.supabase.co/*"
  ],
  "action": {
    "default_title": "SlotBuddy Quick Add",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rainbet.com/*",
        "https://www.rainbet.com/*"
      ],
      "js": [
        "rainbet.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jessicaedgar1997.github.io/stream-leaderboard/*"
      ],
      "js": [
        "slotbuddy-auth.js"
      ],
      "run_at": "document_idle"
    }
  ]
}